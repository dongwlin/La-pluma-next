{
  "name": "la-pluma-next-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "node server.ts",
    "start": "node server.ts",
    "check": "node scripts/check-syntax.js",
    "typecheck": "node scripts/typecheck.ts",
    "build": "pnpm run check",
    "test": "node scripts/run-tests.ts",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage",
    "verify": "pnpm run check && pnpm run typecheck && pnpm run test",
    "fetch-materials": "node scripts/fetch-operator-materials.ts",
    "fetch-formulas": "node scripts/fetch-material-formulas.ts && node scripts/merge-formulas.ts",
    "fetch-all-materials": "node scripts/fetch-all-materials.ts",
    "fetch-drop-data": "node scripts/fetch-penguin-stats.ts",
    "fetch-stages": "node scripts/fetch-stage-data.ts",
    "fetch-assets": "node scripts/fetch-game-assets.ts",
    "fetch-paradox": "node scripts/fetch-paradox-operators.ts",
    "fetch-game-data": "pnpm run fetch-stages && pnpm run fetch-paradox"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.9.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "6.0.3"
  }
}
