# 依赖
node_modules/
client/node_modules/
server/node_modules/

# 构建产物（Docker 会在镜像内重新构建）
client/dist/
client/.vite/

# 日志
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# 环境变量（示例文件可进入构建上下文，便于自建镜像参考）
.env*
**/.env*
!.env.example
!**/.env.example

# 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# 测试
coverage/
.nyc_output/

# 临时文件
tmp/
temp/
server/.temp-maa-resource/

# 用户配置和数据（不要打包进镜像）
server/data/
server/debug/
docker-data/

# 学习参考资料
study/

# 文档
*.md
!README.md

# CI/CD
.github/
.gitlab-ci.yml
