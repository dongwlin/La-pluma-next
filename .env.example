# Copy to .env before using docker-compose.yml.
# Compose refuses to start when LA_PLUMA_TOKEN is unset.

# Required: protect /api/* and the WebRTC signaling ticket endpoint.
# Generate a long random value, for example: openssl rand -hex 32
LA_PLUMA_TOKEN=change-me

# Default ADB device address used by the container.
ADB_ADDRESS=192.168.1.100:5555

# Optional: timeout in ms for Core install/update maintenance commands.
# Default 900000 (15 minutes), capped at 3600000; invalid values fall back.
# LA_PLUMA_MAA_MAINTENANCE_TIMEOUT_MS=900000

# Optional: enable the gray-release native `maa copilot` delegation for
# eligible copilot sets. Default is disabled; set to one of 1/true/on/yes/
# enable/enabled (case-insensitive) to enable it explicitly.
# LA_PLUMA_COPILOT_NATIVE_DELEGATION=1

# Optional: local icon/avatar root for /game-assets (expects item/ and avatar/
# subdirectories; item files are named by item id, avatar files by operator id).
# Defaults to the MAA resource templates
# (resource/template/items and resource/template/avatar). Item keys are also
# resolved from item_table iconId through the local item_table.json when present.
# LA_PLUMA_GAME_ASSET_DIR=/path/to/game-assets
