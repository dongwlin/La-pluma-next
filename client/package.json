{
  "name": "la-pluma-next-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-precache.ts",
    "lint": "eslint . --max-warnings 12",
    "preview": "vite preview",
    "type-check": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:ratchet": "node scripts/stylelint-ratchet.ts",
    "stylelint:baseline": "node scripts/stylelint-ratchet.ts --update-baseline",
    "verify": "pnpm run lint && pnpm run type-check && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@lisse/react": "^0.5.2",
    "framer-motion": "^12.29.2",
    "lucide-react": "^1.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.2.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.11"
  }
}
