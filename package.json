{
  "name": "la-pluma-next",
  "version": "0.0.7",
  "private": true,
  "description": "La Pluma Next - MAA CLI 的现代化 WebUI 与本地 Agent 控制台",
  "license": "MIT",
  "author": "dongwlin and contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongwlin/La-pluma-next.git"
  },
  "homepage": "https://github.com/dongwlin/La-pluma-next#readme",
  "bugs": {
    "url": "https://github.com/dongwlin/La-pluma-next/issues"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=12.6.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "dev:client": "pnpm --filter la-pluma-next-client dev",
    "dev:server": "pnpm --filter la-pluma-next-server dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "verify": "pnpm -r verify",
    "visual": "node scripts/visual-docker.mjs",
    "visual:update": "node scripts/visual-docker.mjs --update-snapshots",
    "start": "pnpm --filter la-pluma-next-server start"
  }
}
